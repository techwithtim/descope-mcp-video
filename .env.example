# Copy to .env and fill in.

# Descope Console -> Agentic Identity Hub -> MCP Servers -> your server -> "Connect your MCP server to Descope" -> Well-Known URL
DESCOPE_CONFIG_URL=https://api.descope.com/v1/apps/agentic/P2xxxxxxxx/M2xxxxxxxx/.well-known/openid-configuration

# Public URL of THIS server, ending in /mcp. Must match "MCP Server URL" in the Descope console.
# Local: http://localhost:8000/mcp   Deployed: https://notes.yourdomain.com/mcp
MCP_SERVER_URL=http://localhost:8000/mcp

# Optional bonus: the id of a GitHub Connection you created under Agentic Identity Hub -> Connections
# GITHUB_CONNECTION_ID=github
